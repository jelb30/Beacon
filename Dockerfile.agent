# Build the beacon-agent Linux binary.
FROM golang:1.25 AS builder

ARG TARGETOS=linux
ARG TARGETARCH

WORKDIR /workspace

COPY go.mod go.mod
COPY go.sum go.sum
RUN go mod download

COPY . .

RUN target_arch="${TARGETARCH:-$(go env GOARCH)}" && \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH="${target_arch}" \
    go build -trimpath -ldflags="-s -w" -o /workspace/beacon-agent ./cmd/beacon-agent

# Use a normal Linux userspace for future cgroup/eBPF detector work.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      bash \
      ca-certificates \
      coreutils \
      findutils \
      iproute2 \
      kmod \
      procps \
      util-linux && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /workspace/beacon-agent /usr/local/bin/beacon-agent

ENTRYPOINT ["/usr/local/bin/beacon-agent"]
